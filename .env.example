# Frontend (Vite) — prefix with VITE_ to expose to the browser bundle.
# Set this to your deployed Cloudflare Worker URL in production.
VITE_API_BASE_URL=https://teka-muna-worker.YOUR_SUBDOMAIN.workers.dev/api

# Cloudflare Worker secrets — set locally in .dev.vars (never commit).
# In production: wrangler secret put GEMINI_API_KEY
#                wrangler secret put TAVILY_API_KEY
GEMINI_API_KEY=
TAVILY_API_KEY=
